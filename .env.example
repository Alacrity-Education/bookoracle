# Copy these into Coolify's environment-variable panel for the stack.

# Image tag to deploy. `latest` follows main; pin to sha-<short> to freeze a
# known-good pair of frontend/backend images.
IMAGE_TAG=latest

# SMTP for result emails. STARTTLS is always used, so there is no toggle.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=LIRA <your-email@example.com>

# Not listed, and deliberately so:
#   BACKEND_URL   set in docker-compose.yml to the internal service address.
#   CORS_ORIGINS  unused while the API stays internal; set it on the backend
#                 only if you later give the API its own public domain.
